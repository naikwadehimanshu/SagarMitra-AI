# SagarMitra AI - Environment Configuration

# Application
APP_NAME=SagarMitra AI
APP_ENV=development
DEBUG=true
DEMO_MODE=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPLIBRE_STYLE=https://demotiles.maplibre.org/style.json

# LLM Configuration (optional - demo mode works without)
LLM_PROVIDER=openai  # openai | gemini | mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Database (optional - uses SQLite/in-memory by default)
DATABASE_URL=sqlite:///./sagarmitra.db
# DATABASE_URL=postgresql://user:password@localhost:5432/sagarmitra

# Redis (optional - uses in-memory cache by default)
REDIS_URL=

# External APIs (optional - demo data used when unavailable)
OPEN_METEO_ENABLED=true
INCOIS_API_KEY=
MOSDAC_API_KEY=
